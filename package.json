{
  "name": "application-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage.enabled true",
    "lint": "eslint .",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "test:scripts": "tsx --test scripts/*.test.ts",
    "update:team-names": "tsx scripts/update-team-names.ts",
    "gen:types": "npx supabase gen types typescript --local > src/types/database.types.ts",
    "sync:texts": "tsx scripts/sync-texts.ts",
    "process:config": "tsx scripts/process-config.ts",
    "test:e2e": "cypress run",
    "test:e2e:chrome": "cypress run --browser chrome"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@reduxjs/toolkit": "^2.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "github-markdown-css": "^5.9.0",
    "next": "^16.4.5",
    "nodemailer": "^10.4.0",
    "pino-logflare": "^0.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cypress": "^16.2.1",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "license-report": "^6.8.6",
    "marked": "^18.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "uuid": "^14.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
